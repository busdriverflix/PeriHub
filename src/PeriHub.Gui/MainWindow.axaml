<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PeriHub.Gui.MainWindow"
        Title="PeriHub" Width="940" Height="700" MinWidth="130" MinHeight="460">

  <Window.Resources>
    <!-- Simple line icons, 24x24 grid, drawn as strokes -->
    <StreamGeometry x:Key="IconHeadset">M4 14 V12 A8 8 0 0 1 20 12 V14 M4 14 h3 v6 h-2 a1 1 0 0 1 -1 -1 z M20 14 h-3 v6 h2 a1 1 0 0 0 1 -1 z</StreamGeometry>
    <StreamGeometry x:Key="IconGamepad">M7 8 h10 a4 4 0 0 1 4 4 v2 a3 3 0 0 1 -5.2 2 l-1.3 -1.5 h-4.9 l-1.3 1.5 a3 3 0 0 1 -5.2 -2 v-2 a4 4 0 0 1 4 -4 z M8 10.5 v3 M6.5 12 h3 M15.5 11 h.01 M17.5 13 h.01</StreamGeometry>
    <StreamGeometry x:Key="IconKeyboard">M3 7 h18 a1 1 0 0 1 1 1 v8 a1 1 0 0 1 -1 1 h-18 a1 1 0 0 1 -1 -1 v-8 a1 1 0 0 1 1 -1 z M6 10 h.01 M10 10 h.01 M14 10 h.01 M18 10 h.01 M7.5 13.5 h9</StreamGeometry>
    <StreamGeometry x:Key="IconMouse">M12 3 a6 6 0 0 1 6 6 v6 a6 6 0 0 1 -12 0 v-6 a6 6 0 0 1 6 -6 z M12 3 v6</StreamGeometry>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*">
    <TextBlock x:Name="ConnectionBanner" Grid.Row="0" IsVisible="False" Foreground="#E5484D" TextWrapping="Wrap" Margin="16,12,16,0"
               Text="Der PeriHub-Core läuft nicht. Starte ihn, dann verbindet sich dieses Fenster automatisch."/>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">

      <!-- LEFT: update button + device tiles -->
      <DockPanel x:Name="LeftPanel" Grid.Column="0" Width="260" Margin="12">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
          <Button x:Name="UpdateAllButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Nach Updates suchen"/>
          <TextBlock x:Name="UpdateAllResult" FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
        </StackPanel>
        <ListBox x:Name="DeviceList" Background="Transparent"/>
      </DockPanel>

      <!-- MIDDLE: detail panes (one visible at a time) -->
      <Grid x:Name="DetailArea" Grid.Column="1">

        <!-- Headset -->
        <Grid x:Name="HeadsetPane" RowDefinitions="*,Auto">
          <Path Grid.RowSpan="2" Data="{StaticResource IconHeadset}" Stroke="Gray" StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round"
                Stretch="Uniform" Width="300" Height="300" Opacity="0.07" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,64" IsHitTestVisible="False"/>
          <ScrollViewer Grid.Row="0">
            <StackPanel Margin="20,12,20,12" Spacing="12">
              <TextBlock Text="Logitech PRO X 2" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock x:Name="HeadsetStatus" Opacity="0.7"/>
              <ProgressBar x:Name="HeadsetBattery" Minimum="0" Maximum="100" Height="8"/>

              <TextBlock Text="Lautstärke" FontWeight="SemiBold" Margin="0,10,0,0"/>
              <DockPanel>
                <TextBlock x:Name="VolumeLabel" DockPanel.Dock="Right" Width="48" TextAlignment="Right"/>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100"/>
              </DockPanel>

              <TextBlock Text="Equalizer" FontWeight="SemiBold" Margin="0,10,0,0"/>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox x:Name="PresetBox" Width="260" PlaceholderText="Preset wählen …"/>
                <Button x:Name="ResetEqButton" Content="Zurücksetzen" ToolTip.Tip="Alle Bänder auf 0 dB"/>
              </StackPanel>
              <Grid ColumnDefinitions="*,*,*,*,*" Height="170" MaxWidth="460" HorizontalAlignment="Left" Width="460">
                <StackPanel Grid.Column="0" HorizontalAlignment="Center"><Slider x:Name="Band0" Orientation="Vertical" Minimum="-10" Maximum="10" Height="130"/><TextBlock Text="Tief" HorizontalAlignment="Center" FontSize="11"/></StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center"><Slider x:Name="Band1" Orientation="Vertical" Minimum="-10" Maximum="10" Height="130"/><TextBlock Text="Bass" HorizontalAlignment="Center" FontSize="11"/></StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center"><Slider x:Name="Band2" Orientation="Vertical" Minimum="-10" Maximum="10" Height="130"/><TextBlock Text="Mitte" HorizontalAlignment="Center" FontSize="11"/></StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center"><Slider x:Name="Band3" Orientation="Vertical" Minimum="-10" Maximum="10" Height="130"/><TextBlock Text="Höhen" HorizontalAlignment="Center" FontSize="11"/></StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Center"><Slider x:Name="Band4" Orientation="Vertical" Minimum="-10" Maximum="10" Height="130"/><TextBlock Text="Brillanz" HorizontalAlignment="Center" FontSize="11"/></StackPanel>
              </Grid>
              <TextBlock Text="Werte in dB. Das Headset hat 5 Bänder; die genauen Frequenzen stehen noch nicht fest." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>

              <TextBlock Text="Mikrofon-Rücklauf (Sidetone)" FontWeight="SemiBold" Margin="0,10,0,0"/>
              <DockPanel>
                <TextBlock x:Name="SidetoneLabel" DockPanel.Dock="Right" Width="48" TextAlignment="Right"/>
                <Slider x:Name="SidetoneSlider" Minimum="0" Maximum="128"/>
              </DockPanel>

              <TextBlock Text="Automatisch ausschalten nach" FontWeight="SemiBold" Margin="0,10,0,0"/>
              <ComboBox x:Name="InactiveBox" Width="260" HorizontalAlignment="Left"/>

              <TextBlock Text="Virtueller Surround" FontWeight="SemiBold" Margin="0,10,0,0"/>
              <ToggleSwitch x:Name="SurroundToggle" OnContent="An" OffContent="Aus"/>
              <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                         Text="Rechnet 7.1-Ton mit einem Raumklang-Filter (HRTF) auf den Kopfhörer um. Beim Einschalten wird &quot;PeriHub Surround&quot; die Standard-Ausgabe, beim Ausschalten wieder das Headset."/>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="20,8,20,16">
            <TextBlock x:Name="HeadsetUpdateResult" VerticalAlignment="Center" FontSize="12" Opacity="0.8" MaxWidth="360" TextWrapping="Wrap"/>
            <Button x:Name="HeadsetUpdateButton" Content="Nach Updates suchen"/>
          </StackPanel>
        </Grid>

        <!-- DualSense -->
        <Grid x:Name="PadPane" RowDefinitions="*,Auto" IsVisible="False">
          <Path Grid.RowSpan="2" Data="{StaticResource IconGamepad}" Stroke="Gray" StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round"
                Stretch="Uniform" Width="300" Height="300" Opacity="0.07" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,64" IsHitTestVisible="False"/>
          <StackPanel Grid.Row="0" Margin="20,12,20,12" Spacing="12">
            <TextBlock Text="DualSense Controller" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="PadStatus" Opacity="0.7"/>
            <ProgressBar x:Name="PadBattery" Minimum="0" Maximum="100" Height="8"/>
            <TextBlock x:Name="PadInfo" Opacity="0.8"/>
            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                       Text="Firmware-Updates gibt es nur über Sonys Windows-Tool; PeriHub zeigt hier nur die installierte Version."/>
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="20,8,20,16">
            <TextBlock x:Name="PadUpdateResult" VerticalAlignment="Center" FontSize="12" Opacity="0.8" MaxWidth="360" TextWrapping="Wrap"/>
            <Button x:Name="PadUpdateButton" Content="Nach Updates suchen"/>
          </StackPanel>
        </Grid>

        <!-- Keyboard (placeholder) -->
        <Grid x:Name="KeyboardPane" RowDefinitions="*,Auto" IsVisible="False">
          <Path Grid.RowSpan="2" Data="{StaticResource IconKeyboard}" Stroke="Gray" StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round"
                Stretch="Uniform" Width="300" Height="300" Opacity="0.07" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,64" IsHitTestVisible="False"/>
          <StackPanel Grid.Row="0" Margin="20,12,20,12" Spacing="12">
            <TextBlock Text="ROCCAT Vulcan II" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Noch keine Steuerung. Geplant: Beleuchtung."/>
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="20,8,20,16">
            <TextBlock x:Name="KeyboardUpdateResult" VerticalAlignment="Center" FontSize="12" Opacity="0.8" MaxWidth="360" TextWrapping="Wrap"/>
            <Button x:Name="KeyboardUpdateButton" Content="Nach Updates suchen"/>
          </StackPanel>
        </Grid>

        <!-- Mouse (placeholder) -->
        <Grid x:Name="MousePane" RowDefinitions="*,Auto" IsVisible="False">
          <Path Grid.RowSpan="2" Data="{StaticResource IconMouse}" Stroke="Gray" StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round"
                Stretch="Uniform" Width="300" Height="300" Opacity="0.07" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,64" IsHitTestVisible="False"/>
          <StackPanel Grid.Row="0" Margin="20,12,20,12" Spacing="12">
            <TextBlock Text="SteelSeries Aerox 5 Wireless" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="MouseStatus" Opacity="0.7"/>
            <ProgressBar x:Name="MouseBattery" Minimum="0" Maximum="100" Height="8"/>

            <TextBlock Text="Beleuchtung" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <ComboBox x:Name="MouseModeBox" Width="260" HorizontalAlignment="Left"/>
            <StackPanel x:Name="MouseColors" Orientation="Horizontal" Spacing="24" Margin="0,6,0,0">
              <StackPanel Spacing="4"><TextBlock Text="Oben" FontSize="12"/><ColorPicker x:Name="TopColor" Color="#FF0000"/></StackPanel>
              <StackPanel Spacing="4"><TextBlock Text="Mitte" FontSize="12"/><ColorPicker x:Name="MiddleColor" Color="#00FF00"/></StackPanel>
              <StackPanel Spacing="4"><TextBlock Text="Unten" FontSize="12"/><ColorPicker x:Name="BottomColor" Color="#0000FF"/></StackPanel>
            </StackPanel>
            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                       Text="Die Farben werden im Speicher der Maus abgelegt und beim Verbinden vom Core erneut gesetzt. Weitere Funktionen der Maus (DPI, Tasten) kommen später."/>
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="20,8,20,16">
            <TextBlock x:Name="MouseUpdateResult" VerticalAlignment="Center" FontSize="12" Opacity="0.8" MaxWidth="360" TextWrapping="Wrap"/>
            <Button x:Name="MouseUpdateButton" Content="Nach Updates suchen"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- RIGHT: collapse strip -->
      <Button x:Name="CollapseButton" Grid.Column="2" Width="28" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center" Margin="0,12,12,12" Padding="0" Content="‹" FontSize="18"
              ToolTip.Tip="Einklappen / Ausklappen"/>
    </Grid>
  </Grid>
</Window>
